Config {
   -- appearance
     font =         "xft:DejaVu Sans Mono:size=12:bold:antialias=true"
   , bgColor =      "#3f3f3f"
   , fgColor =      "#dcdccc"
   , position =     TopW L 90      -- leave the right 10% for trayer
   , border =       BottomB
   , borderColor =  "#646464"
   -- layout
   , sepChar =  "%"
   , alignSep = "}{"
   , template = "%XMonadLog% }{ %wlan0% | %multicoretemp% | %default:Master% | %date% "
   -- general behavior
   , lowerOnStart = True
   , hideOnStart = False
   , allDesktops = True
   , overrideRedirect = True
   , pickBroadest = False
   , persistent = True
   -- plugins (refresh rates are in tenths of a second)
   , commands =
        [ Run Network "wlan0" [ "--template" , "<dev>: <tx>kB/s|<rx>kB/s"
                              , "--Low"      , "1000"
                              , "--High"     , "5000"
                              , "--low"      , "#7f9f7f"
                              , "--normal"   , "#f0dfaf"
                              , "--high"     , "#cc9393"
                              ] 20                      -- 2 s
        , Run MultiCoreTemp [ "--template" , "Temp: <avg>°C"
                              , "--Low"      , "70"
                              , "--High"     , "80"
                              , "--low"      , "#7f9f7f"
                              , "--normal"   , "#f0dfaf"
                              , "--high"     , "#cc9393"
                              ] 100                     -- 10 s
        , Run Volume "default" "Master"
            [ "-t", "<status>: <volume>%"
            , "--"
            , "-O", "Vol"
            , "-o", "Mute"
            , "-C", "#f0dfaf"
            , "-c", "#cc9393"
            ] 20                                        -- 2 s
        , Run Date "<action=`gsimplecal`>%a %b %_d %H:%M</action>" "date" 100  -- 10 s
        , Run XMonadLog
        ]
   }
